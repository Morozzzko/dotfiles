#!/usr/bin/env bash
# Single entrypoint for setting up a new machine.
# Run this script repeatedly — each step is idempotent.
set -euo pipefail

DOTFILES_DIR="$(cd "$(dirname "$0")/.." && pwd)"

step() {
  echo
  echo "==> $1"
}

# ── Homebrew ──────────────────────────────────────────────────────────────────

step "Homebrew"
if command -v brew &>/dev/null; then
  echo "  ✓ Already installed"
else
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# ── Brew packages ─────────────────────────────────────────────────────────────

step "Brew packages"
if [ -f "$DOTFILES_DIR/Brewfile" ]; then
  brew bundle --file="$DOTFILES_DIR/Brewfile"
else
  echo "  – No Brewfile found, skipping"
fi

# ── Stow ──────────────────────────────────────────────────────────────────────

step "Stow"
if ! command -v stow &>/dev/null; then
  echo "  ✗ stow is not installed — add it to Brewfile or install it manually" >&2
  exit 1
fi
for pkg in fish nvim shell git mise; do
  stow --dir="$DOTFILES_DIR" --target="$HOME" --restow "$pkg"
  echo "  ✓ $pkg"
done

# ── Default shell ─────────────────────────────────────────────────────────────

step "Default shell"
FISH="$(which fish 2>/dev/null || true)"
if [ -z "$FISH" ]; then
  echo "  ✗ fish not found — ensure it is in Brewfile" >&2
  exit 1
fi
if [ "$SHELL" = "$FISH" ]; then
  echo "  ✓ Already set to fish"
else
  if ! grep -qxF "$FISH" /etc/shells; then
    echo "  Adding fish to /etc/shells (requires sudo)..."
    echo "$FISH" | sudo tee -a /etc/shells > /dev/null
  fi
  chsh -s "$FISH"
  echo "  ✓ Default shell set to fish (re-login to apply)"
fi

# ── iTerm2 ────────────────────────────────────────────────────────────────────

step "iTerm2"
ITERM_PREFS="$DOTFILES_DIR/iterm2"
if [ ! -d "$ITERM_PREFS" ]; then
  echo "  – No iterm2/ directory found, skipping"
else
  defaults write com.googlecode.iterm2 PrefsCustomFolder -string "$ITERM_PREFS"
  defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
  echo "  ✓ Preferences pointing to $ITERM_PREFS"
  echo "  – Restart iTerm2 to apply"
fi

# ── Mise ──────────────────────────────────────────────────────────────────────

step "Mise"
if ! command -v mise &>/dev/null; then
  echo "  ✗ mise not installed — add it to Brewfile" >&2
  exit 1
fi
mise install --quiet
echo "  ✓ Tools installed"

# ── Secrets file ──────────────────────────────────────────────────────────────

step "Secrets"
if [ -f "$HOME/.profile_secrets" ]; then
  echo "  ✓ ~/.profile_secrets already exists"
else
  touch "$HOME/.profile_secrets"
  echo "  ✓ Created ~/.profile_secrets"
fi

# ── Git ───────────────────────────────────────────────────────────────────────

step "Git"
git config --global user.name "Igor Morozov"
echo "  ✓ user.name = Igor Morozov"

current_email="$(git config --global user.email 2>/dev/null || true)"
if [ -n "$current_email" ]; then
  echo "  ✓ user.email = $current_email (already set)"
else
  read -rp "  Email [igor@morozov.is]: " email
  git config --global user.email "${email:-igor@morozov.is}"
  echo "  ✓ user.email = ${email:-igor@morozov.is}"
fi

# ── Shared projects ───────────────────────────────────────────────────────────

step "Shared projects"
SHARED_DIR="/Users/Shared/projects"
LINK="$HOME/projects/shared"
mkdir -p "$SHARED_DIR"
if [ -L "$LINK" ] && [ "$(readlink "$LINK")" = "$SHARED_DIR" ]; then
  echo "  ✓ ~/projects/shared already linked"
else
  mkdir -p "$HOME/projects"
  ln -sfn "$SHARED_DIR" "$LINK"
  echo "  ✓ ~/projects/shared → $SHARED_DIR"
fi

# ── Typography Layout ─────────────────────────────────────────────────────────

step "Typography Layout (Ilya Birman)"
KEYBOARD_LAYOUTS_DIR="$HOME/Library/Keyboard Layouts"
if ls "$KEYBOARD_LAYOUTS_DIR"/*.keylayout &>/dev/null; then
  echo "  ✓ Already installed"
else
  TYPO_LAYOUT_URL="https://ilyabirman.ru/typography-layout/download/ilya-birman-typolayout-3.9-mac.zip"
  echo "  Downloading..."
  TMP_DIR="$(mktemp -d)"
  curl -fsSL "$TYPO_LAYOUT_URL" -o "$TMP_DIR/typolayout.zip"
  unzip -q "$TMP_DIR/typolayout.zip" -d "$TMP_DIR"
  mkdir -p "$KEYBOARD_LAYOUTS_DIR"
  find "$TMP_DIR" -name "*.keylayout" -exec cp {} "$KEYBOARD_LAYOUTS_DIR/" \;
  find "$TMP_DIR" -name "*.icns" -exec cp {} "$KEYBOARD_LAYOUTS_DIR/" \; 2>/dev/null || true
  rm -rf "$TMP_DIR"
  echo "  ✓ Installed — log out and back in, then enable in System Settings → Keyboard → Input Sources"
fi

# ── Apps ──────────────────────────────────────────────────────────────────────

step "Apps"
"$DOTFILES_DIR/bin/apps/check"
